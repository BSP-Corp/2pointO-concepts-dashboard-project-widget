// Widget.project_update(string quo_data) — UPDATE one Project. Custom API: Widget_Project_Update (PUT, quo_data).
// quo_data: {"project_id":"…","data":{only the changed fields},"reason":"…"}; dates dd-MMM-yyyy, lookups = record ID, "" clears.
// Project_Status follows the static order of Widget.status_order(): next stage only; back needs a reason; skipping needs admin;
// "On Hold" / "Cancelled" can be set at any stage. Every status change appends a line to Status_History:
//   dd-MMM-yyyy HH:mm:ss | <Status> | <User> | <Reason>
// End date (Project_Completion_Date) must be on or after Start_Date.
map Widget.project_update(string quo_data)
{
	response = Map();
	try 
	{
		req = quo_data.toMap();
		data = ifnull(req.get("data"),Map());
		projRec = Project[ID == ifnull(req.get("project_id"),"0").toString().toLong()];
		ruleError = "";
		newStatusName = "";
		if(projRec.count() > 0 && data.containKey("Project_Status"))
		{
			order = thisapp.Widget.status_order();
			stages = order.get("project");
			anytime = order.get("anytime");
			newText = ifnull(data.get("Project_Status"),"").toString();
			newStatusRec = Status[ID == 0];
			if(newText.isNumber())
			{
				newStatusRec = Status[ID == newText.toLong()];
			}
			if(newStatusRec.count() > 0)
			{
				newStatusName = ifnull(newStatusRec.Status_Name,"").trim();
			}
			currentName = "";
			if(projRec.Project_Status != null)
			{
				currentName = ifnull(projRec.Project_Status.Status_Name,"").trim();
			}
			toPos = stages.indexOf(newStatusName);
			fromPos = stages.indexOf(currentName);
			loginRec = Users[Email == zoho.loginuserid];
			roleAdmin = false;
			if(loginRec.count() > 0)
			{
				roleAdmin = ifnull(loginRec.Role,"") == "Administrator";
			}
			isAdmin = zoho.loginuser == zoho.adminuser || zoho.loginuserid.equalsIgnoreCase(zoho.adminuserid) || roleAdmin;
			notStage = toPos < 0 && !anytime.contains(newStatusName);
			if(newStatusName == "" || notStage)
			{
				ruleError = "The selected status is not a project stage";
			}
			else if(toPos >= 0 && fromPos >= 0 && toPos > fromPos + 1 && !isAdmin)
			{
				ruleError = "Stages cannot be skipped — move to the next stage";
			}
			else if(toPos >= 0 && fromPos >= 0 && toPos < fromPos && ifnull(req.get("reason"),"").toString().trim() == "")
			{
				ruleError = "A reason is required to move the project back";
			}
		}
		startText = ifnull(data.get("Start_Date"),"").toString().trim();
		endText = ifnull(data.get("Project_Completion_Date"),"").toString().trim();
		if(projRec.count() > 0 && ruleError == "")
		{
			startValue = projRec.Start_Date;
			endValue = projRec.Project_Completion_Date;
			if(data.containKey("Start_Date"))
			{
				startValue = null;
				if(startText != "")
				{
					startValue = startText.toDate();
				}
			}
			if(data.containKey("Project_Completion_Date"))
			{
				endValue = null;
				if(endText != "")
				{
					endValue = endText.toDate();
				}
			}
			if(startValue != null && endValue != null && endValue < startValue)
			{
				ruleError = "Project Completion Date must be on or after the Start Date";
			}
		}
		if(projRec.count() == 0)
		{
			response = {"status":"error","code":"NOT_FOUND","message":"Project not found"};
		}
		else if(ruleError != "")
		{
			response = {"status":"error","code":"INVALID","message":ruleError};
		}
		else
		{
			before = thisapp.Widget.activity_values("Project",projRec.ID.toString());
			dateFields = {"Start_Date","Project_Completion_Date","Actual_Completion_Date","Date_PO_Received"};
			moneyFields = {"Project_Value_PO","Estimate_Value_Sub_Total","Hardware","Software","Outsourced_Services","Logistics","point0_Services","Estimated_Margin","Total_Budget_Cost"};
			for each  fieldName in data.keys()
			{
				textValue = ifnull(data.get(fieldName),"").toString().trim();
				dateValue = null;
				numberValue = null;
				idValue = null;
				if(textValue != "" && dateFields.contains(fieldName))
				{
					dateValue = textValue.toDate();
				}
				if(textValue != "" && moneyFields.contains(fieldName))
				{
					numberValue = textValue.toDecimal();
				}
				if(textValue.isNumber())
				{
					idValue = textValue.toLong();
				}
				if(fieldName == "Project_Reference")
				{
					projRec.Project_Reference=textValue;
				}
				else if(fieldName == "Project_Name")
				{
					projRec.Project_Name=textValue;
				}
				else if(fieldName == "Type_of_Project")
				{
					projRec.Type_of_Project=textValue;
				}
				else if(fieldName == "City")
				{
					projRec.City=textValue;
				}
				else if(fieldName == "State")
				{
					projRec.State=textValue;
				}
				else if(fieldName == "Project_Description")
				{
					projRec.Project_Description=textValue;
				}
				else if(fieldName == "Client_PO_No")
				{
					projRec.Client_PO_No=textValue;
				}
				else if(fieldName == "Sales_Order_No")
				{
					projRec.Sales_Order_No=textValue;
				}
				else if(fieldName == "Start_Date")
				{
					projRec.Start_Date=dateValue;
				}
				else if(fieldName == "Project_Completion_Date")
				{
					projRec.Project_Completion_Date=dateValue;
				}
				else if(fieldName == "Actual_Completion_Date")
				{
					projRec.Actual_Completion_Date=dateValue;
				}
				else if(fieldName == "Date_PO_Received")
				{
					projRec.Date_PO_Received=dateValue;
				}
				else if(fieldName == "Project_Value_PO")
				{
					projRec.Project_Value_PO=numberValue;
				}
				else if(fieldName == "Estimate_Value_Sub_Total")
				{
					projRec.Estimate_Value_Sub_Total=numberValue;
				}
				else if(fieldName == "Hardware")
				{
					projRec.Hardware=numberValue;
				}
				else if(fieldName == "Software")
				{
					projRec.Software=numberValue;
				}
				else if(fieldName == "Outsourced_Services")
				{
					projRec.Outsourced_Services=numberValue;
				}
				else if(fieldName == "Logistics")
				{
					projRec.Logistics=numberValue;
				}
				else if(fieldName == "point0_Services")
				{
					projRec.point0_Services=numberValue;
				}
				else if(fieldName == "Estimated_Margin")
				{
					projRec.Estimated_Margin=numberValue;
				}
				else if(fieldName == "Total_Budget_Cost")
				{
					projRec.Total_Budget_Cost=numberValue;
				}
				else if(fieldName == "Client_Name")
				{
					projRec.Client_Name=idValue;
				}
				else if(fieldName == "Project_Status")
				{
					projRec.Project_Status=idValue;
				}
				else if(fieldName == "Currency")
				{
					projRec.Currency=idValue;
				}
				else if(fieldName == "Accepted_Estimate")
				{
					projRec.Accepted_Estimate=idValue;
				}
				else if(fieldName == "Project_Registration_Task_List")
				{
					projRec.Project_Registration_Task_List=idValue;
				}
				else if(fieldName == "Project_Manager")
				{
					projRec.Project_Manager=idValue;
				}
				else if(fieldName == "Solution_Architect")
				{
					projRec.Solution_Architect=idValue;
				}
				else if(fieldName == "Finance_Representative")
				{
					projRec.Finance_Representative=idValue;
				}
				else if(fieldName == "Health_Safety_Manager")
				{
					projRec.Health_Safety_Manager=idValue;
				}
				else if(fieldName == "Sales_Representative")
				{
					projRec.Sales_Representative=idValue;
				}
				else if(fieldName == "Lead_Engineer")
				{
					projRec.Lead_Engineer=idValue;
				}
				else if(fieldName == "Logistics_Coordinator")
				{
					projRec.Logistics_Coordinator=idValue;
				}
				else if(fieldName == "Sales_Person")
				{
					projRec.Sales_Person=idValue;
				}
				else if(fieldName == "Project_manager_Approval")
				{
					projRec.Project_manager_Approval=idValue;
				}
				else if(fieldName == "Country")
				{
					countryIds = List();
					for each  countryId in data.get("Country")
					{
						countryIds.add(countryId.toString().toLong());
					}
					projRec.Country=countryIds;
				}
				else if(fieldName == "Address")
				{
					addressData = data.get("Address");
					projRec.Address.address_line_1=ifnull(addressData.get("address_line_1"),"");
					projRec.Address.address_line_2=ifnull(addressData.get("address_line_2"),"");
				}
			}
			if(newStatusName != "")
			{
				userName = zoho.loginuser;
				historyUser = Users[Email == zoho.loginuserid];
				if(historyUser.count() > 0 && ifnull(historyUser.Name,"") != "")
				{
					userName = historyUser.Name;
				}
				line = zoho.currenttime.toString("dd-MMM-yyyy HH:mm:ss") + " | " + newStatusName + " | " + userName + " | " + ifnull(req.get("reason"),"").toString().trim().replaceAll("[\r\n|]"," ");
				history = ifnull(projRec.Status_History,"").trim();
				projRec.Status_History=if(history == "",line,history + "\n" + line);
			}
			// Activity stream: every changed project field (status moves are also in Status_History)
			thisapp.Widget.activity_add(projRec.ID.toString(),"Project",projRec.ID.toString(),ifnull(projRec.Project_Reference,""),before,thisapp.Widget.activity_values("Project",projRec.ID.toString()));
			response = {"status":"success","id":projRec.ID.toString()};
		}
	}
	catch (e)
	{
		response = {"status":"error","code":"EXCEPTION","message":e.toString()};
	}
	return response;
}
