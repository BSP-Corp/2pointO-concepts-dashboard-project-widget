map Widget.project_task_update(string quo_data)
{
	response = Map();
	try 
	{
		req = quo_data.toMap();
		data = ifnull(req.get("data"),Map());
		projRec = Project[ID == ifnull(req.get("project_id"),"0").toString().toLong()];
		taskText = ifnull(req.get("task_id"),"").toString();
		lineText = ifnull(req.get("line_id"),"").toString();
		boqText = ifnull(req.get("boq_id"),"").toString();
		milestoneText = ifnull(req.get("milestone_id"),"").toString();
		actionText = ifnull(req.get("action"),"").toString();
		parentIdText = ifnull(req.get("parent_id"),"").toString();
		eid = 0;
		if(projRec.count() > 0)
		{
			eid = ifnull(projRec.Accepted_Estimate,0);
		}
		if(projRec.count() == 0)
		{
			response = {"status":"error","code":"NOT_FOUND","message":"Project not found"};
		}
		else if(actionText == "create_milestone")
		{
			newMsName = ifnull(data.get("Milestone_Name"),"").toString().trim();
			newAfterText = ifnull(data.get("Starts_after"),"0").toString().trim();
			newUnitText = ifnull(data.get("Starts_After_In"),"Days").toString();
			newDurationText = ifnull(data.get("Duration"),"1").toString().trim();
			msErrors = List();
			msUnits = {"Days","Weeks","Months"};
			if(newMsName == "")
			{
				msErrors.add("Enter the milestone name");
			}
			if(!newAfterText.isNumber())
			{
				msErrors.add("Starts after must be a whole number of 0 or more");
			}
			if(!msUnits.contains(newUnitText))
			{
				msErrors.add("Starts after in must be Days, Weeks or Months");
			}
			if(!newDurationText.isNumber())
			{
				msErrors.add("Duration must be a whole number of days");
			}
			if(msErrors.size() > 0)
			{
				response = {"status":"error","code":"INVALID","message":msErrors.toString(". ")};
			}
			else
			{
				newMsStatus = null;
				msStatusRec = Status[Modules.contains("Milestone") && Index_field == 44];
				if(msStatusRec.count() > 0)
				{
					newMsStatus = msStatusRec.ID;
				}
				newMsId = insert into Milestone
				[
					Added_User=zoho.loginuser
					Milestone_No=thisapp.Creator.AutoGenerateNo("Milestone")
					Milestone_Name=newMsName
					Project=projRec.ID
					Parent_Project=projRec.ID
					Status=newMsStatus
					Starts_after=newAfterText.toLong()
					Starts_After_In=newUnitText
					Duration=newDurationText.toLong()
				];
				response = {"status":"success","id":newMsId.toString()};
			}
		}
		else if(actionText == "create_task")
		{
			newTaskName = ifnull(data.get("Task_Name"),"").toString().trim();
			newStartText = ifnull(data.get("Task_Start_Date"),"").toString().trim();
			newEndText = ifnull(data.get("Task_End_Date"),"").toString().trim();
			taskErrors = List();
			listRec = Task[ID == 0];
			taskMsId = null;
			if(parentIdText.isNumber())
			{
				listRec = Task[ID == parentIdText.toLong() && Project_Name == projRec.ID];
				if(listRec.count() == 0)
				{
					taskErrors.add("Parent task not found in this project");
				}
				else
				{
					taskMsId = listRec.Milestone;
				}
			}
			else
			{
				addMsRec = Milestone[ID == 0];
				if(milestoneText.isNumber())
				{
					addMsRec = Milestone[ID == milestoneText.toLong() && Project == projRec.ID];
				}
				if(addMsRec.count() == 0)
				{
					taskErrors.add("Milestone not found in this project");
				}
				else
				{
					taskMsId = addMsRec.ID;
				}
			}
			if(newTaskName == "")
			{
				taskErrors.add("Enter the task name");
			}
			newStart = null;
			newEnd = null;
			if(newStartText != "")
			{
				newStart = newStartText.toDate();
			}
			if(newEndText != "")
			{
				newEnd = newEndText.toDate();
			}
			if(newStart != null && newEnd != null)
			{
				if(newEnd < newStart)
				{
					taskErrors.add("Due date must be on or after the start date");
				}
			}
			if(taskErrors.size() > 0)
			{
				response = {"status":"error","code":"INVALID","message":taskErrors.toString(". ")};
			}
			else
			{
				addTaskStatus = null;
				addStatusRec = Status[Modules.contains("Task") && Index_field == 1];
				if(addStatusRec.count() > 0)
				{
					addTaskStatus = addStatusRec.ID;
				}
				newTaskType = "Task";
				newParentId = null;
				newWorkPackage = "";
				newWorkLines = List();
				if(listRec.count() > 0)
				{
					newParentId = listRec.ID;
					newTaskType = ifnull(listRec.Type_field,"Task");
					newWorkPackage = ifnull(listRec.Work_Package,"");
					newWorkLines = ifnull(listRec.Work_Packages,List());
				}
				if(newTaskType == "")
				{
					newTaskType = "Task";
				}
				newTaskId = insert into Task
				[
					Added_User=zoho.loginuser
					Task_No=thisapp.Creator.AutoGenerateNo("Task")
					Task_Name=newTaskName
					Project_Name=projRec.ID
					Type_field=newTaskType
					Task_Status=addTaskStatus
					Parent_Task=newParentId
					Milestone=taskMsId
					Work_Package=newWorkPackage
					Work_Packages=newWorkLines
					Task_Start_Date=newStart
					Task_End_Date=newEnd
				];
				if(newStartText != "" && newEndText != "")
				{
					addedTaskRec = Task[ID == newTaskId];
					addedTaskRec.Duration=newStartText.toDate().daysBetween(newEndText.toDate()) + 1;
				}
				response = {"status":"success","id":newTaskId.toString()};
			}
		}
		else if(lineText.isNumber())
		{
			lineRec = Costing_Lineitem[ID == lineText.toLong()];
			lineInProject = false;
			if(lineRec.count() > 0)
			{
				lineInProject = lineRec.Project == projRec.ID;
				if(!lineInProject && eid != 0)
				{
					lineInProject = lineRec.Cost_Analysis == eid;
				}
			}
			if(!lineInProject)
			{
				response = {"status":"error","code":"NOT_FOUND","message":"Asset line not found in this project"};
			}
			else
			{
				before = thisapp.Widget.activity_values("Asset",lineRec.ID.toString());
				if(data.containKey("Installation_Status"))
				{
					statusText = ifnull(data.get("Installation_Status"),"").toString();
					statusId = null;
					if(statusText.isNumber())
					{
						statusId = statusText.toLong();
					}
					lineRec.Installation_Status=statusId;
				}
				if(data.containKey("Delivery_Status"))
				{
					statusText = ifnull(data.get("Delivery_Status"),"").toString();
					statusId = null;
					if(statusText.isNumber())
					{
						statusId = statusText.toLong();
					}
					lineRec.Delivery_Status=statusId;
				}
				textFields = {"Notes","Serial_Number","MAC_Address_Control","MAC_Address_Dante","Provision","Outlet_GOP_No","Switch_Ref","Port_No","POE","VLAN","IP_Address","Subnet_Mask","Host_Name","Gateway","DNS_Server_1","DNS_Server_2"};
				for each  fieldName in data.keys()
				{
					textValue = ifnull(data.get(fieldName),"").toString().trim();
					if(textFields.contains(fieldName))
					{
						if(fieldName == "Notes")
						{
							lineRec.Notes=textValue;
						}
						else if(fieldName == "Serial_Number")
						{
							lineRec.Serial_Number=textValue;
						}
						else if(fieldName == "MAC_Address_Control")
						{
							lineRec.MAC_Address_Control=textValue;
						}
						else if(fieldName == "MAC_Address_Dante")
						{
							lineRec.MAC_Address_Dante=textValue;
						}
						else if(fieldName == "Provision")
						{
							lineRec.Provision=textValue;
						}
						else if(fieldName == "Outlet_GOP_No")
						{
							lineRec.Outlet_GOP_No=textValue;
						}
						else if(fieldName == "Switch_Ref")
						{
							lineRec.Switch_Ref=textValue;
						}
						else if(fieldName == "Port_No")
						{
							lineRec.Port_No=textValue;
						}
						else if(fieldName == "POE")
						{
							lineRec.POE=textValue;
						}
						else if(fieldName == "VLAN")
						{
							lineRec.VLAN=textValue;
						}
						else if(fieldName == "IP_Address")
						{
							lineRec.IP_Address=textValue;
						}
						else if(fieldName == "Subnet_Mask")
						{
							lineRec.Subnet_Mask=textValue;
						}
						else if(fieldName == "Host_Name")
						{
							lineRec.Host_Name=textValue;
						}
						else if(fieldName == "Gateway")
						{
							lineRec.Gateway=textValue;
						}
						else if(fieldName == "DNS_Server_1")
						{
							lineRec.DNS_Server_1=textValue;
						}
						else
						{
							lineRec.DNS_Server_2=textValue;
						}
					}
					else if(fieldName == "Warranty_Start_Date" || fieldName == "Warranty_End_Date")
					{
						warrantyDate = null;
						if(textValue != "")
						{
							warrantyDate = textValue.toDate();
						}
						if(fieldName == "Warranty_Start_Date")
						{
							lineRec.Warranty_Start_Date=warrantyDate;
						}
						else
						{
							lineRec.Warranty_End_Date=warrantyDate;
						}
					}
					else if(fieldName == "Networked")
					{
						lineRec.Networked=textValue == "true";
					}
				}
				lineName = ifnull(lineRec.Model,"");
				if(lineName == "")
				{
					lineName = ifnull(lineRec.Item_Description,"Asset line");
				}
				thisapp.Widget.activity_add(projRec.ID.toString(),"Asset",lineRec.ID.toString(),lineName,before,thisapp.Widget.activity_values("Asset",lineRec.ID.toString()));
				response = {"status":"success","id":lineRec.ID.toString()};
			}
		}
		else if(actionText == "save_contact")
		{
			contactIdText = ifnull(req.get("contact_id"),"").toString().trim();
			contactFirst = ifnull(data.get("First_Name"),"").toString().trim();
			contactLast = ifnull(data.get("Last_Name"),"").toString().trim();
			contactEmail = ifnull(data.get("Email"),"").toString().trim();
			contactMobile = ifnull(data.get("Mobile"),"").toString().trim();
			contactDesignation = ifnull(data.get("Designation"),"").toString().trim();
			contactErrors = List();
			if(contactFirst == "")
			{
				contactErrors.add("Enter the first name");
			}
			if(contactEmail != "")
			{
				if(!contactEmail.contains("@") || !contactEmail.contains("."))
				{
					contactErrors.add("Enter a valid email");
				}
			}
			contactRec = Contact_Persons[ID == 0];
			if(contactIdText != "")
			{
				if(contactIdText.isNumber())
				{
					contactRec = Contact_Persons[ID == contactIdText.toLong() && Project == projRec.ID];
				}
				if(contactRec.count() == 0)
				{
					contactErrors.add("Contact not found in this project");
				}
			}
			if(contactErrors.size() > 0)
			{
				response = {"status":"error","code":"INVALID","message":contactErrors.toString(". ")};
			}
			else
			{
				contactName = Map();
				contactName.put("first_name",contactFirst);
				contactName.put("last_name",contactLast);
				contactData = Map();
				contactData.put("Name",contactName);
				contactData.put("Email",contactEmail);
				contactData.put("Mobile",contactMobile);
				contactData.put("Designation",contactDesignation);
				contactHeaders = Map();
				contactHeaders.put("environment","development");
				contactBody = Map();
				contactApi = "https://www.zohoapis.com/creator/v2.1/data/2point0concepts/point0concepts";
				if(contactIdText == "")
				{
					contactData.put("Project",projRec.ID.toString());
					contactBody.put("data",contactData);
					contactResp = invokeurl
					[
						url :contactApi + "/form/Contact_Persons"
						type :POST
						parameters:contactBody.toString()
						headers:contactHeaders
						connection:"zoho_creator"
					];
				}
				else
				{
					contactBody.put("data",contactData);
					contactResp = invokeurl
					[
						url :contactApi + "/report/All_Contact_Persons/" + contactIdText
						type :PATCH
						parameters:contactBody.toString()
						headers:contactHeaders
						connection:"zoho_creator"
					];
				}
				if(ifnull(contactResp.get("code"),"").toString() == "3000")
				{
					contactSaved = contactIdText;
					if(contactSaved == "")
					{
						contactData = ifnull(contactResp.get("data"),Map());
						contactSaved = ifnull(contactData.get("ID"),"").toString();
					}
					response = {"status":"success","id":contactSaved};
				}
				else
				{
					contactError = ifnull(contactResp.get("error"),"").toString();
					if(contactError == "")
					{
						contactError = ifnull(contactResp.get("message"),"").toString();
					}
					if(contactError == "")
					{
						contactError = contactResp.toString();
					}
					response = {"status":"error","code":"INVALID","message":"Contact not saved: " + contactError};
				}
			}
		}
		else if(actionText == "save_attendance")
		{
			attUserText = ifnull(data.get("User_ID"),"").toString().trim();
			attValue = ifnull(data.get("Attendance"),"").toString().trim();
			attAllowed = {"Present","Absent",""};
			attUserCount = 0;
			if(attUserText.isNumber())
			{
				attUserCount = Users[ID == attUserText.toLong()].count();
			}
			if(attUserCount == 0)
			{
				response = {"status":"error","code":"INVALID","message":"Choose the employee first"};
			}
			else if(!attAllowed.contains(attValue))
			{
				response = {"status":"error","code":"INVALID","message":"Attendance must be Present or Absent"};
			}
			else
			{
				attUserId = attUserText.toLong();
				attRec = Meeting_Attendee[Project == projRec.ID && Employee_Name == attUserId];
				attSavedId = "";
				if(attRec.count() > 0)
				{
					attRec.Attendance=attValue;
					attSavedId = attRec.ID.toString();
				}
				else
				{
					attNewId = insert into Meeting_Attendee
					[
						Added_User=zoho.loginuser
						Employee_Name=attUserId
						Attendance=attValue
						Project=projRec.ID
					];
					attSavedId = attNewId.toString();
				}
				response = {"status":"success","id":attSavedId};
			}
		}
		else if(milestoneText.isNumber())
		{
			msRec = Milestone[ID == milestoneText.toLong()];
			if(msRec.count() == 0 || msRec.Project != projRec.ID)
			{
				response = {"status":"error","code":"NOT_FOUND","message":"Milestone not found in this project"};
			}
			else
			{
				errors = List();
				afterText = ifnull(data.get("Starts_after"),"").toString().trim();
				durationText = ifnull(data.get("Duration"),"").toString().trim();
				unitText = ifnull(data.get("Starts_After_In"),"").toString();
				flagText = ifnull(data.get("Flag"),"").toString();
				ownerText = ifnull(data.get("Owner"),"").toString();
				statusText = ifnull(data.get("Status"),"").toString();
				msNameText = ifnull(data.get("Milestone_Name"),"").toString().trim();
				units = {"Days","Weeks","Months"};
				if(data.containKey("Milestone_Name") && msNameText == "")
				{
					errors.add("Enter the milestone name");
				}
				flags = {"Internal","External"};
				if(data.containKey("Starts_after") && afterText != "" && !afterText.isNumber())
				{
					errors.add("Starts after must be a whole number of 0 or more");
				}
				if(data.containKey("Duration") && durationText != "" && !durationText.isNumber())
				{
					errors.add("Duration must be a whole number of days");
				}
				if(data.containKey("Starts_After_In") && unitText != "" && !units.contains(unitText))
				{
					errors.add("Starts after in must be Days, Weeks or Months");
				}
				if(data.containKey("Flag") && flagText != "" && !flags.contains(flagText))
				{
					errors.add("Flag must be Internal or External");
				}
				if(ownerText != "")
				{
					validOwner = false;
					if(ownerText.isNumber())
					{
						validOwner = Users[ID == ownerText.toLong()].count() > 0;
					}
					if(!validOwner)
					{
						errors.add("Owner not found in Users");
					}
				}
				if(statusText != "")
				{
					validStatus = false;
					if(statusText.isNumber())
					{
						validStatus = Status[ID == statusText.toLong() && Modules.contains("Milestone")].count() > 0;
					}
					if(!validStatus)
					{
						errors.add("Status is not a Milestone status");
					}
				}
				if(errors.size() > 0)
				{
					response = {"status":"error","code":"INVALID","message":errors.toString(". ")};
				}
				else
				{
					before = thisapp.Widget.activity_values("Milestone",msRec.ID.toString());
					if(data.containKey("Milestone_Name"))
					{
						msRec.Milestone_Name=msNameText;
					}
					if(msRec.Parent_Project == null)
					{
						msRec.Parent_Project=projRec.ID;
					}
					if(data.containKey("Starts_after"))
					{
						afterValue = null;
						if(afterText != "")
						{
							afterValue = afterText.toLong();
						}
						msRec.Starts_after=afterValue;
					}
					if(data.containKey("Starts_After_In"))
					{
						msRec.Starts_After_In=unitText;
					}
					if(data.containKey("Duration"))
					{
						durationValue = null;
						if(durationText != "")
						{
							durationValue = durationText.toLong();
						}
						msRec.Duration=durationValue;
					}
					if(data.containKey("Flag"))
					{
						msRec.Flag=flagText;
					}
					if(data.containKey("Owner"))
					{
						if(ownerText == "")
						{
							msRec.Owner=null;
						}
						else
						{
							msRec.Owner=ownerText.toLong();
						}
					}
					if(data.containKey("Status"))
					{
						if(statusText == "")
						{
							msRec.Status=null;
						}
						else
						{
							msRec.Status=statusText.toLong();
						}
					}
					thisapp.Widget.activity_add(projRec.ID.toString(),"Milestone",msRec.ID.toString(),ifnull(msRec.Milestone_Name,""),before,thisapp.Widget.activity_values("Milestone",msRec.ID.toString()));
					response = {"status":"success","id":msRec.ID.toString()};
				}
			}
		}
		else if(boqText.isNumber())
		{
			boqRec = BOQ[ID == boqText.toLong()];
			inProject = false;
			if(boqRec.count() > 0)
			{
				byEstimate = eid != 0 && boqRec.Estimate1 == eid;
				byReference = ifnull(projRec.Project_Reference,"") != "" && boqRec.Project_Reference == projRec.Project_Reference;
				inProject = boqRec.Project == projRec.ID || byEstimate || byReference;
			}
			if(!inProject)
			{
				response = {"status":"error","code":"NOT_FOUND","message":"BOQ line not found in this project"};
			}
			else
			{
				before = thisapp.Widget.activity_values("BOQ",boqRec.ID.toString());
				poDate = boqRec.PO_Date;
				eta = boqRec.ETA;
				for each  dateField in {"PO_Date","ETA","Date_delivered_to_warehouse","Date_delivered_to_customer"}
				{
					if(data.containKey(dateField))
					{
						dateText = ifnull(data.get(dateField),"").toString().trim();
						dateValue = null;
						if(dateText != "")
						{
							dateValue = dateText.toDate();
						}
						if(dateField == "PO_Date")
						{
							poDate = dateValue;
						}
						else if(dateField == "ETA")
						{
							eta = dateValue;
						}
						else if(dateField == "Date_delivered_to_warehouse")
						{
							boqRec.Date_delivered_to_warehouse=dateValue;
						}
						else
						{
							boqRec.Date_delivered_to_customer=dateValue;
						}
					}
				}
				statusError = "";
				if(data.containKey("Status"))
				{
					ruleStatusText = ifnull(data.get("Status"),"").toString();
					if(ruleStatusText.isNumber())
					{
						if(boqRec.Status == null || boqRec.Status.toString() != ruleStatusText)
						{
							ruleStatusRec = Status[ID == ruleStatusText.toLong()];
							ruleName = ifnull(ruleStatusRec.Status_Name,"").toLowerCase();
							receiptOnly = false;
							if(ruleName.contains("warehouse"))
							{
								receiptOnly = true;
							}
							if(ruleName.contains("office"))
							{
								receiptOnly = true;
							}
							if(ruleName.contains("delivered"))
							{
								receiptOnly = true;
							}
							notStarted = false;
							if(ruleName.contains("order pending"))
							{
								notStarted = true;
							}
							if(ruleName.contains("not ordered"))
							{
								notStarted = true;
							}
							if(receiptOnly)
							{
								statusError = ifnull(ruleStatusRec.Status_Name,"This status") + " is set only by goods receipt or a delivery note";
							}
							else if(!notStarted)
							{
								ruleVendor = boqRec.Vendors;
								if(data.containKey("Vendors"))
								{
									ruleVendor = ifnull(data.get("Vendors"),"").toString();
								}
								ruleCost = 0;
								ruleCostIds = ifnull(boqRec.Costing_Lineitem,List());
								if(ruleCostIds.size() > 0)
								{
									for each  ruleCostRec in Costing_Lineitem[ID in ruleCostIds]
									{
										ruleCost = ruleCost + ifnull(ruleCostRec.Total_Cost,0);
									}
								}
								ruleMode = ifnull(boqRec.Mode_of_Transit,"");
								if(data.containKey("Mode_of_Transit"))
								{
									ruleMode = ifnull(data.get("Mode_of_Transit"),"").toString();
								}
								if(ifnull(ruleVendor,"").toString() == "")
								{
									statusError = "Set the vendor before moving the line past Not Started";
								}
								else if(ruleCost <= 0)
								{
									statusError = "This line has no unit cost (Cost Analysis) — add it before moving past Not Started";
								}
								else if(ruleName.contains("transit") || ruleName.contains("customs"))
								{
									if(eta == null)
									{
										statusError = "Enter the ETA date before setting " + ifnull(ruleStatusRec.Status_Name,"this status");
									}
									else if(ruleMode == "")
									{
										statusError = "Enter the mode of transit before setting " + ifnull(ruleStatusRec.Status_Name,"this status");
									}
								}
							}
						}
					}
				}
				if(statusError != "")
				{
					response = {"status":"error","code":"INVALID","message":statusError};
				}
				else if(poDate != null && eta != null && eta < poDate)
				{
					response = {"status":"error","code":"INVALID","message":"ETA must be on or after the PO date"};
				}
				else
				{
					boqRec.PO_Date=poDate;
					boqRec.ETA=eta;
					if(data.containKey("Status"))
					{
						statusText = ifnull(data.get("Status"),"").toString();
						statusId = null;
						if(statusText.isNumber())
						{
							statusId = statusText.toLong();
						}
						boqRec.Status=statusId;
					}
					if(data.containKey("Vendors"))
					{
						vendorText = ifnull(data.get("Vendors"),"").toString();
						vendorId = null;
						if(vendorText.isNumber())
						{
							if(Vendors[ID == vendorText.toLong()].count() > 0)
							{
								vendorId = vendorText.toLong();
							}
						}
						boqRec.Vendors=vendorId;
					}
					if(data.containKey("PO"))
					{
						boqRec.PO=ifnull(data.get("PO"),"").toString().trim();
					}
					if(data.containKey("Mode_of_Transit"))
					{
						boqRec.Mode_of_Transit=ifnull(data.get("Mode_of_Transit"),"").toString();
					}
					if(data.containKey("Delivered_to_2_0_Warehouse"))
					{
						boqRec.Delivered_to_2_0_Warehouse=ifnull(data.get("Delivered_to_2_0_Warehouse"),"").toString();
					}
					if(data.containKey("Delivered_to_Customer"))
					{
						boqRec.Delivered_to_Customer=ifnull(data.get("Delivered_to_Customer"),"").toString();
					}
					boqName = ifnull(boqRec.Model,"");
					if(boqRec.SKU != null)
					{
						boqName = ifnull(boqRec.SKU.SKU,boqName);
					}
					if(boqName == "")
					{
						boqName = ifnull(boqRec.Description,"BOQ line");
					}
					thisapp.Widget.activity_add(projRec.ID.toString(),"BOQ",boqRec.ID.toString(),boqName,before,thisapp.Widget.activity_values("BOQ",boqRec.ID.toString()));
					response = {"status":"success","id":boqRec.ID.toString()};
				}
			}
		}
		else
		{
			tid = 0;
			if(taskText.isNumber())
			{
				tid = taskText.toLong();
			}
			taskRec = Task[ID == tid && Project_Name == projRec.ID];
			if(taskRec.count() == 0)
			{
				response = {"status":"error","code":"NOT_FOUND","message":"Task not found in this project"};
			}
			else
			{
				startDate = taskRec.Task_Start_Date;
				endDate = taskRec.Task_End_Date;
				if(data.containKey("Task_Start_Date"))
				{
					dateText = ifnull(data.get("Task_Start_Date"),"").toString().trim();
					startDate = null;
					if(dateText != "")
					{
						startDate = dateText.toDate();
					}
				}
				if(data.containKey("Task_End_Date"))
				{
					dateText = ifnull(data.get("Task_End_Date"),"").toString().trim();
					endDate = null;
					if(dateText != "")
					{
						endDate = dateText.toDate();
					}
				}
				ownerIds = List();
				outsiders = List();
				for each  ownerId in ifnull(data.get("Owners"),List())
				{
					ownerText = ownerId.toString();
					if(ownerText.isNumber())
					{
						if(Users[ID == ownerText.toLong()].count() > 0)
						{
							ownerIds.add(ownerText.toLong());
						}
						else
						{
							outsiders.add(ownerText);
						}
					}
					else
					{
						outsiders.add(ownerText);
					}
				}
				if(startDate != null && endDate != null && endDate < startDate)
				{
					response = {"status":"error","code":"INVALID","message":"Due date must be on or after the start date"};
				}
				else if(data.containKey("Owners") && outsiders.size() > 0)
				{
					response = {"status":"error","code":"INVALID","message":"Assignees must be users of the app (Users form)"};
				}
				else
				{
					before = thisapp.Widget.activity_values("Task",taskRec.ID.toString());
					taskRec.Task_Start_Date=startDate;
					if(data.containKey("Duration"))
					{
						durationText = ifnull(data.get("Duration"),"").toString().trim();
						durationValue = null;
						if(durationText.isNumber())
						{
							durationValue = durationText.toLong();
						}
						taskRec.Duration=durationValue;
					}
					taskRec.Task_End_Date=endDate;
					if(data.containKey("Actual_Start_Date"))
					{
						dateText = ifnull(data.get("Actual_Start_Date"),"").toString().trim();
						actualStart = null;
						if(dateText != "")
						{
							actualStart = dateText.toDate();
						}
						taskRec.Actual_Start_Date=actualStart;
					}
					if(data.containKey("Actual_Complete_Date"))
					{
						dateText = ifnull(data.get("Actual_Complete_Date"),"").toString().trim();
						actualEnd = null;
						if(dateText != "")
						{
							actualEnd = dateText.toDate();
						}
						taskRec.Actual_Complete_Date=actualEnd;
					}
					if(data.containKey("Task_Status"))
					{
						statusText = ifnull(data.get("Task_Status"),"").toString();
						statusId = null;
						if(statusText.isNumber())
						{
							statusId = statusText.toLong();
						}
						taskRec.Task_Status=statusId;
					}
					if(data.containKey("Task_Name") && ifnull(data.get("Task_Name"),"").toString().trim() != "")
					{
						taskRec.Task_Name=data.get("Task_Name").toString().trim();
					}
					if(data.containKey("Task_Description"))
					{
						taskRec.Task_Description=ifnull(data.get("Task_Description"),"").toString();
					}
					if(data.containKey("Work_Hours"))
					{
						hoursText = ifnull(data.get("Work_Hours"),"").toString().trim();
						hoursValue = null;
						if(hoursText != "")
						{
							hoursValue = hoursText.toDecimal();
						}
						taskRec.Work_Hours=hoursValue;
					}
					if(data.containKey("Billing_Type"))
					{
						taskRec.Billing_Type=ifnull(data.get("Billing_Type"),"").toString();
					}
					if(data.containKey("Parent_Task"))
					{
						parentText = ifnull(data.get("Parent_Task"),"").toString();
						parentId = null;
						if(parentText.isNumber())
						{
							parentRec = Task[ID == parentText.toLong()];
							if(parentRec.count() > 0 && parentRec.Project_Name == projRec.ID && parentRec.ID != taskRec.ID)
							{
								parentId = parentRec.ID;
							}
						}
						taskRec.Parent_Task=parentId;
					}
					if(data.containKey("Milestone"))
					{
						taskMsText = ifnull(data.get("Milestone"),"").toString();
						taskNewMsId = null;
						if(taskMsText.isNumber())
						{
							taskMsCheck = Milestone[ID == taskMsText.toLong() && Project == projRec.ID];
							if(taskMsCheck.count() > 0)
							{
								taskNewMsId = taskMsCheck.ID;
							}
						}
						taskRec.Milestone=taskNewMsId;
					}
					if(data.containKey("Priority"))
					{
						taskRec.Priority=ifnull(data.get("Priority"),"").toString();
					}
					if(data.containKey("Precent_Complete"))
					{
						taskRec.Precent_Complete=ifnull(data.get("Precent_Complete"),"0").toString().toDecimal();
					}
					if(data.containKey("Owners"))
					{
						taskRec.Owners=ownerIds;
					}
					thisapp.Widget.activity_add(projRec.ID.toString(),"Task",taskRec.ID.toString(),ifnull(taskRec.Task_Name,""),before,thisapp.Widget.activity_values("Task",taskRec.ID.toString()));
					response = {"status":"success","id":taskRec.ID.toString()};
				}
			}
		}
	}
	catch (e)
	{
		response = {"status":"error","code":"EXCEPTION","message":e.toString()};
	}
	return response;
}
