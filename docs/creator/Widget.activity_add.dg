// Widget.activity_add(string project_id, string module, string record_id, string record_name, map before, map after)
// Writes one Activity_Stream record per field whose text changed (before → after). An empty "before" = the record was
// created: one "created" line. Returns the number of lines written. No Custom API.
// Called by project_update, project_task_update, project_risk_save and the optional Edit workflows (docs/ACTIVITY_STREAM.md).
int Widget.activity_add(string project_id, string module, string record_id, string record_name, map before, map after)
{
	written = 0;
	pid = 0;
	if(project_id.isNumber())
	{
		pid = project_id.toLong();
	}
	actUser = Users[Email == zoho.loginuserid];
	userName = zoho.loginuser;
	if(actUser.count() > 0)
	{
		if(ifnull(actUser.Name,"") != "")
		{
			userName = actUser.Name;
		}
	}
	if(before.size() == 0)
	{
		insert into Activity_Stream
		[
			Added_User=zoho.loginuser
			Project=pid
			Module=module
			Record_ID=record_id
			Record_Name=record_name
			Action_field="created"
			Field_Name=""
			Old_Value=""
			New_Value=""
			Changed_By=userName
			Changed_On=zoho.currentdate
		]
		written = 1;
	}
	else
	{
		for each  label in after.keys()
		{
			oldText = ifnull(before.get(label),"").toString().trim();
			newText = ifnull(after.get(label),"").toString().trim();
			// labels missing from "before" are not compared (Edit workflows send only the fields they track)
			if(before.containKey(label) && oldText != newText)
			{
				insert into Activity_Stream
				[
					Added_User=zoho.loginuser
					Project=pid
					Module=module
					Record_ID=record_id
					Record_Name=record_name
					Action_field="updated"
					Field_Name=label
					Old_Value=oldText
					New_Value=newText
					Changed_By=userName
					Changed_On=zoho.currentdate
				]
				written = written + 1;
			}
		}
	}
	return written;
}
