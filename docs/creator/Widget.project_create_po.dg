map Widget.project_create_po(string quo_data)
{
	response = Map();
	try 
	{
		req = quo_data.toMap();
		projRec = Project[ID == ifnull(req.get("project_id"),"0").toString().toLong()];
		eidValue = 0;
		if(projRec.count() > 0)
		{
			eidValue = ifnull(projRec.Accepted_Estimate,0);
		}
		vendorText = ifnull(req.get("vendor_id"),"").toString();
		countryText = ifnull(req.get("country_id"),"").toString();
		lines = ifnull(req.get("lines"),List());
		errors = List();
		existingText = ifnull(req.get("po_id"),"").toString();
		existingId = 0;
		if(existingText.isNumber())
		{
			existingPo = Purchase_Order[ID == existingText.toLong()];
			if(existingPo.count() == 0)
			{
				errors.add("The selected purchase order no longer exists");
			}
			else if(existingPo.Project_reference != projRec.ID)
			{
				errors.add("The selected purchase order belongs to another project");
			}
			else if(existingPo.Vendor_Name.toString() != vendorText)
			{
				errors.add("The selected purchase order is for another vendor");
			}
			else
			{
				existingId = existingPo.ID;
			}
		}
		if(projRec.count() == 0)
		{
			errors.add("Project not found");
		}
		if(!vendorText.isNumber())
		{
			errors.add("Select a vendor");
		}
		if(!countryText.isNumber())
		{
			errors.add("Select a country");
		}
		if(lines.size() == 0)
		{
			errors.add("Add at least one BOQ line");
		}
		boqIds = List();
		subTotal = 0.0;
		divisionValues = {"Audio Visual","Digital Signage","Shared/Overhead"};
		transitValues = {"Road","Air","Sea"};
		transitText = ifnull(req.get("mode_of_transit"),"").toString();
		if(transitText != "" && !transitValues.contains(transitText))
		{
			errors.add("Mode of transit must be Road, Air or Sea");
		}
		etaText = ifnull(req.get("eta"),"").toString();
		for each  line in lines
		{
			boqRec = BOQ[ID == ifnull(line.get("boq_id"),"0").toString().toLong()];
			productText = ifnull(line.get("product_id"),"").toString();
			lineDivision = ifnull(line.get("division"),"").toString();
			if(!divisionValues.contains(lineDivision) && !errors.contains("Select the reporting tag (Division) of every line"))
			{
				errors.add("Select the reporting tag (Division) of every line");
			}
			quantity = ifnull(line.get("quantity"),"0").toString().toDecimal();
			rate = ifnull(line.get("rate"),"0").toString().toDecimal();
			if(boqRec.count() == 0 || !productText.isNumber())
			{
				errors.add("A line has no BOQ item / product");
			}
			else if(quantity <= 0 || rate < 0)
			{
				errors.add(ifnull(boqRec.Description,"Line") + ": quantity must be above 0 and rate 0 or more");
			}
			else
			{
				ordered = 0.0;
				for each  poLineRec in PO_Line_Items[Item_Name == productText.toLong() && is_PR == false]
				{
					poRec = Purchase_Order[ID == poLineRec.Purchase_Order];
					if(poRec.count() > 0 && ifnull(poRec.BOQ,List()).contains(boqRec.ID.toString()))
					{
						ordered = ordered + ifnull(poLineRec.Quantity,0);
					}
				}
				if(ordered + quantity > ifnull(boqRec.Quantity,0))
				{
					errors.add(ifnull(boqRec.Description,"Line") + ": ordered " + ordered + " + " + quantity + " exceeds BOQ quantity " + ifnull(boqRec.Quantity,0));
				}
				if(!boqIds.contains(boqRec.ID))
				{
					boqIds.add(boqRec.ID);
				}
				subTotal = subTotal + quantity * rate;
			}
		}
		if(errors.size() == 0)
		{
			vendorError = thisapp.ZohoBooks.Ensure_Vendor_Books_ID(vendorText.toLong(),countryText.toLong());
			if(vendorError != "")
			{
				errors.add(vendorError);
			}
		}
		if(errors.size() > 0)
		{
			response = {"status":"error","code":"INVALID","message":errors.toString("; ")};
		}
		else
		{
			apiBase = "https://www.zohoapis.com/creator/v2.1/data/2point0concepts/point0concepts";
			apiHeaders = Map();
			apiHeaders.put("environment","development");
			discount = ifnull(req.get("discount"),"0").toString().toDecimal();
			poDate = zoho.currentdate;
			if(ifnull(req.get("date"),"").toString() != "")
			{
				poDate = req.get("date").toString().toDate();
			}
			termsText = ifnull(req.get("terms"),"").toString().trim();
			termsDays = ifnull(req.get("terms_days"),"").toString().trim();
			if(termsDays.isNumber())
			{
				termsText = ("Payment terms: " + termsDays + " days\n" + termsText).trim();
			}
			newRows = List();
			for each  line in lines
			{
				quantity = line.get("quantity").toString().toDecimal();
				rate = line.get("rate").toString().toDecimal();
				rowMap = Map();
				rowMap.put("Item_Name",line.get("product_id").toString());
				rowMap.put("Item_Description",ifnull(line.get("description"),"").toString());
				rowMap.put("Quantity",quantity.round(0).toLong());
				rowMap.put("Rate",rate);
				rowMap.put("Amount",(quantity * rate).round(2));
				rowMap.put("Quantity_Received",0);
				rowMap.put("Quantity_to_be_Received",quantity.round(0).toLong());
				rowMap.put("is_PR",false);
				rowMap.put("Received",false);
				taxText = ifnull(line.get("tax_id"),"").toString();
				if(taxText.isNumber())
				{
					rowMap.put("Tax",taxText);
				}
				lineText = ifnull(line.get("line_id"),"").toString();
				if(lineText.isNumber())
				{
					rowMap.put("Estimate_Line_ID",lineText);
				}
				boqLineText = ifnull(line.get("boq_id"),"").toString();
				if(boqLineText.isNumber())
				{
					rowMap.put("BOQ",boqLineText);
				}
				rowMap.put("Division",ifnull(line.get("division"),"").toString());
				newRows.add(rowMap);
			}
			taxTotal = 0.0;
			for each  line in lines
			{
				taxText = ifnull(line.get("tax_id"),"").toString();
				if(taxText.isNumber())
				{
					taxRec = Taxes[ID == taxText.toLong()];
					if(taxRec.count() > 0)
					{
						lineAmount = line.get("quantity").toString().toDecimal() * line.get("rate").toString().toDecimal();
						taxTotal = taxTotal + lineAmount * (1 - discount / 100) * ifnull(taxRec.Rate,0) / 100;
					}
				}
			}
			boqList = List();
			for each  boqId in boqIds
			{
				boqList.add(boqId.toString());
			}
			linesBefore = 0;
			poId = 0;
			apiError = "";
			if(existingId == 0)
			{
				poData = Map();
				poData.put("Project_reference",projRec.ID.toString());
				if(eidValue != 0)
				{
					poData.put("Sales_Reference",eidValue.toString());
				}
				poStatusList = Status[Modules.contains("Purchase Order")] sort by Index_field;
				if(poStatusList.count() > 0)
				{
					poData.put("PO_Status",poStatusList.ID.toString());
				}
				warehouseText = ifnull(req.get("warehouse_id"),"").toString();
				if(warehouseText.isNumber())
				{
					poData.put("Warehouse",warehouseText);
				}
				if(projRec.Client_Name != null)
				{
					poData.put("Customer",projRec.Client_Name.toString());
				}
				poData.put("PO_No","NEW");
				poData.put("Vendor_Name",vendorText);
				poData.put("Country",countryText);
				poData.put("Date_field",poDate.toString("dd-MMM-yyyy"));
				if(ifnull(req.get("delivery_date"),"").toString() != "")
				{
					poData.put("Delivery_Date",req.get("delivery_date").toString().toDate().toString("dd-MMM-yyyy"));
				}
				poData.put("Reference",ifnull(req.get("reference"),"").toString());
				poData.put("BOQ",boqList);
				poData.put("Notes",ifnull(req.get("notes"),"").toString());
				poData.put("Terms_Conditions",termsText);
				poData.put("Discount",discount);
				poData.put("Sub_Total",subTotal.round(2));
				poData.put("Total_Cost",(subTotal - subTotal * discount / 100 + taxTotal).round(2));
				poData.put("Item_Table",newRows);
				resultMap = Map();
				resultMap.put("fields",{"PO_No"});
				resultMap.put("message",true);
				bodyMap = Map();
				bodyMap.put("data",poData);
				bodyMap.put("result",resultMap);
				apiResp = invokeurl
				[
					url :apiBase + "/form/Purchase_Order"
					type :POST
					parameters:bodyMap.toString()
					headers:apiHeaders
					connection:"zoho_creator"
				];
				if(ifnull(apiResp.get("code"),"").toString() == "3000")
				{
					apiData = apiResp.get("data");
					poId = apiData.get("ID").toString().toLong();
				}
				else
				{
					apiError = ifnull(apiResp.get("error"),"").toString();
					if(apiError == "")
					{
						apiError = ifnull(apiResp.get("message"),"").toString();
					}
					if(apiError == "")
					{
						apiError = apiResp.toString();
					}
				}
			}
			else
			{
				allRows = List();
				allTotal = 0.0;
				for each  keepLineRec in PO_Line_Items[Purchase_Order == existingId]
				{
					keepRow = Map();
					keepRow.put("ID",keepLineRec.ID.toString());
					allRows.add(keepRow);
					if(keepLineRec.is_PR == false)
					{
						linesBefore = linesBefore + 1;
						allTotal = allTotal + ifnull(keepLineRec.Amount,0);
						if(keepLineRec.Tax != null)
						{
							keepTaxRec = Taxes[ID == keepLineRec.Tax];
							taxTotal = taxTotal + ifnull(keepLineRec.Amount,0) * (1 - ifnull(existingPo.Discount,0) / 100) * ifnull(keepTaxRec.Rate,0) / 100;
						}
					}
				}
				allRows.addAll(newRows);
				allTotal = allTotal + subTotal;
				poBoq = List();
				for each  oldBoq in ifnull(existingPo.BOQ,List())
				{
					poBoq.add(oldBoq.toString());
				}
				for each  newBoq in boqList
				{
					if(!poBoq.contains(newBoq))
					{
						poBoq.add(newBoq);
					}
				}
				existingDiscount = ifnull(existingPo.Discount,0);
				poData = Map();
				poData.put("Item_Table",allRows);
				poData.put("BOQ",poBoq);
				poData.put("Sub_Total",allTotal.round(2));
				poData.put("Total_Cost",(allTotal - allTotal * existingDiscount / 100 + taxTotal).round(2));
				poData.put("PR_All_Received",false);
				bodyMap = Map();
				bodyMap.put("data",poData);
				apiResp = invokeurl
				[
					url :apiBase + "/report/All_Purchase_Orders/" + existingId
					type :PATCH
					parameters:bodyMap.toString()
					headers:apiHeaders
					connection:"zoho_creator"
				];
				if(ifnull(apiResp.get("code"),"").toString() == "3000")
				{
					poId = existingId;
				}
				else
				{
					apiError = ifnull(apiResp.get("error"),"").toString();
					if(apiError == "")
					{
						apiError = ifnull(apiResp.get("message"),"").toString();
					}
					if(apiError == "")
					{
						apiError = apiResp.toString();
					}
				}
			}
			if(poId == 0)
			{
				response = {"status":"error","code":"API","message":"Creator did not save the purchase order: " + apiError};
			}
			else
			{
				poRec = Purchase_Order[ID == poId];
				savedLines = PO_Line_Items[Purchase_Order == poId && is_PR == false].count() - linesBefore;
				if(poRec.count() == 0 || savedLines != lines.size())
				{
					response = {"status":"error","code":"EXCEPTION","message":"The purchase order was not saved completely in Creator (" + savedLines + " of " + lines.size() + " lines)"};
				}
				else
				{
					booksId = ifnull(poRec.UAE_ZB_ID,"");
					if(booksId == "")
					{
						booksId = ifnull(poRec.SAR_ZB_ID,"");
					}
					booksMessage = "";
					if(booksId == "")
					{
						booksMessage = "Saved in Creator. Zoho Books is updated by the Purchase Order workflow — no Books ID yet.";
					}
					etaDate = poRec.Delivery_Date;
					if(existingId == 0)
					{
						if(ifnull(req.get("delivery_date"),"").toString() != "")
						{
							etaDate = req.get("delivery_date").toString().toDate();
						}
					}
					if(etaText != "")
					{
						etaDate = etaText.toDate();
					}
					for each  etaBoqId in boqIds
					{
						etaBoqRec = BOQ[ID == etaBoqId];
						if(etaBoqRec.count() > 0)
						{
							if(etaDate != null)
							{
								etaBoqRec.ETA=etaDate;
							}
							if(transitText != "")
							{
								etaBoqRec.Mode_of_Transit=transitText;
							}
						}
					}
					savedPoNo = ifnull(poRec.Purchase_Order_Books_No,"").trim();
					if(savedPoNo == "")
					{
						savedPoNo = ifnull(poRec.PO_No,"");
					}
					response = {"status":"success","id":poId.toString(),"PO_No":savedPoNo,"Books_Synced":booksId != "","Books_ID":booksId,"Books_Message":booksMessage,"Added_To_Existing":existingId != 0};
				}
			}
		}
	}
	catch (e)
	{
		response = {"status":"error","code":"EXCEPTION","message":e.toString()};
	}
	return response;
}
