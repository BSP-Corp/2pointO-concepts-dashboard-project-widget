// Widget.project_create_po(string quo_data) — Procurement "Create purchase order". Custom API: Widget_Project_Create_PO (POST, quo_data).
// quo_data: {"project_id","vendor_id","country_id","date":"dd-MMM-yyyy","delivery_date","reference","notes","terms","terms_days",
//            "warehouse_id","discount","lines":[{"boq_id","product_id","line_id","description","quantity","rate","tax_id"}]}
// Order: 1) Purchase_Order + PO_Line_Items are created in Creator and checked; 2) only then the EXISTING
// ZohoBooks.Purchase_Order_Creator_books_Sync runs; 3) its result is read back (UAE_ZB_ID / SAR_ZB_ID). PO#, date and
// status are written back to every BOQ line. Issued by = the logged-in user (Added_User).
map Widget.project_create_po(string quo_data)
{
	response = Map();
	try 
	{
		req = quo_data.toMap();
		projRec = Project[ID == ifnull(req.get("project_id"),"0").toString().toLong()];
		eidValue = 0;
		if(projRec.count() > 0)
		{
			eidValue = ifnull(projRec.Accepted_Estimate,0);
		}
		vendorText = ifnull(req.get("vendor_id"),"").toString();
		countryText = ifnull(req.get("country_id"),"").toString();
		lines = ifnull(req.get("lines"),List());
		errors = List();
		if(projRec.count() == 0)
		{
			errors.add("Project not found");
		}
		if(!vendorText.isNumber())
		{
			errors.add("Select a vendor");
		}
		if(!countryText.isNumber())
		{
			errors.add("Select a country");
		}
		if(lines.size() == 0)
		{
			errors.add("Add at least one BOQ line");
		}
		// Procured quantity (existing PO lines for the same BOQ + product) + new quantity must not exceed the BOQ quantity
		boqIds = List();
		subTotal = 0.0;
		for each  line in lines
		{
			boqRec = BOQ[ID == ifnull(line.get("boq_id"),"0").toString().toLong()];
			productText = ifnull(line.get("product_id"),"").toString();
			quantity = ifnull(line.get("quantity"),"0").toString().toDecimal();
			rate = ifnull(line.get("rate"),"0").toString().toDecimal();
			if(boqRec.count() == 0 || !productText.isNumber())
			{
				errors.add("A line has no BOQ item / product");
			}
			else if(quantity <= 0 || rate < 0)
			{
				errors.add(ifnull(boqRec.Description,"Line") + ": quantity must be above 0 and rate 0 or more");
			}
			else
			{
				ordered = 0.0;
				for each  poLineRec in PO_Line_Items[Item_Name == productText.toLong()]
				{
					poRec = Purchase_Order[ID == poLineRec.Purchase_Order];
					if(poRec.count() > 0 && ifnull(poRec.BOQ,List()).contains(boqRec.ID.toString()))
					{
						ordered = ordered + ifnull(poLineRec.Quantity,0);
					}
				}
				if(ordered + quantity > ifnull(boqRec.Quantity,0))
				{
					errors.add(ifnull(boqRec.Description,"Line") + ": ordered " + ordered + " + " + quantity + " exceeds BOQ quantity " + ifnull(boqRec.Quantity,0));
				}
				if(!boqIds.contains(boqRec.ID))
				{
					boqIds.add(boqRec.ID);
				}
				subTotal = subTotal + quantity * rate;
			}
		}
		if(errors.size() > 0)
		{
			response = {"status":"error","code":"INVALID","message":errors.toString("; ")};
		}
		else
		{
			// Same numbering as the Purchase_Order "Update PO Number" workflow
			nextNo = "PO-00001";
			lastRec = Purchase_Order[PO_No != null && PO_No != ""] sort by PO_No desc range from 1 to 1;
			if(lastRec.count() > 0)
			{
				nextNo = "PO-" + leftpad((lastRec.PO_No.getSuffix("PO-").toLong() + 1).toString(),5).replaceAll(" ","0");
			}
			discount = ifnull(req.get("discount"),"0").toString().toDecimal();
			poDate = zoho.currentdate;
			if(ifnull(req.get("date"),"").toString() != "")
			{
				poDate = req.get("date").toString().toDate();
			}
			deliveryDate = null;
			if(ifnull(req.get("delivery_date"),"").toString() != "")
			{
				deliveryDate = req.get("delivery_date").toString().toDate();
			}
			// Terms days → Terms & Conditions (the form has no terms-days field; Books gets it with the terms)
			termsText = ifnull(req.get("terms"),"").toString().trim();
			termsDays = ifnull(req.get("terms_days"),"").toString().trim();
			if(termsDays.isNumber())
			{
				termsText = ("Payment terms: " + termsDays + " days\n" + termsText).trim();
			}
			warehouseText = ifnull(req.get("warehouse_id"),"").toString();
			warehouseId = null;
			if(warehouseText.isNumber())
			{
				warehouseId = warehouseText.toLong();
			}
			// Initial PO status: first Status record of the "Purchase Order" module
			poStatusId = null;
			poStatusList = Status[Modules.contains("Purchase Order")] sort by Index_field;
			if(poStatusList.count() > 0)
			{
				poStatusId = poStatusList.ID;
			}
			salesRef = null;
			if(eidValue != 0)
			{
				salesRef = eidValue;
			}
			poId = insert into Purchase_Order
			[
				Added_User=zoho.loginuser
				Project_reference=projRec.ID
				Sales_Reference=salesRef
				PO_Status=poStatusId
				Warehouse=warehouseId
				Vendor_Name=vendorText.toLong()
				Country=countryText.toLong()
				PO_No=nextNo
				Date_field=poDate
				Delivery_Date=deliveryDate
				Reference=ifnull(req.get("reference"),"").toString()
				Customer=projRec.Client_Name
				BOQ=boqIds
				Notes=ifnull(req.get("notes"),"").toString()
				Terms_Conditions=termsText
				Discount=discount
				Sub_Total=subTotal
				Total_Cost=subTotal - subTotal * discount / 100
			];
			for each  line in lines
			{
				quantity = line.get("quantity").toString().toDecimal();
				rate = line.get("rate").toString().toDecimal();
				lineText = ifnull(line.get("line_id"),"").toString();
				estimateLine = null;
				if(lineText.isNumber())
				{
					estimateLine = lineText.toLong();
				}
				taxText = ifnull(line.get("tax_id"),"").toString();
				taxId = null;
				if(taxText.isNumber())
				{
					taxId = taxText.toLong();
				}
				insert into PO_Line_Items
				[
					Added_User=zoho.loginuser
					Purchase_Order=poId
					Item_Name=line.get("product_id").toString().toLong()
					Item_Description=ifnull(line.get("description"),"").toString()
					Quantity=quantity.round(0).toLong()
					Rate=rate
					Tax=taxId
					Amount=quantity * rate
					Quantity_Received=0
					Quantity_to_be_Received=quantity.round(0).toLong()
					Estimate_Line_ID=estimateLine
				];
			}
			// 1) Check the PO and all its lines exist in Creator before anything goes to Books
			poRec = Purchase_Order[ID == poId];
			savedLines = PO_Line_Items[Purchase_Order == poId].count();
			if(poRec.count() == 0 || savedLines != lines.size())
			{
				response = {"status":"error","code":"EXCEPTION","message":"The purchase order was not saved completely in Creator (" + savedLines + " of " + lines.size() + " lines) — nothing was sent to Zoho Books"};
			}
			else
			{
				// 2) Write PO#, date and status back to every BOQ line (comma-separated PO# when a line has several POs)
				orderedStatus = null;
				for each  boqStatusRec in Status[Modules.contains("BOQ")]
				{
					if(ifnull(boqStatusRec.Status_Name,"").trim().toLowerCase().startsWith("ordered"))
					{
						orderedStatus = boqStatusRec.ID;
					}
				}
				for each  boqId in boqIds
				{
					boqRec = BOQ[ID == boqId];
					if(ifnull(boqRec.PO,"").trim() == "")
					{
						boqRec.PO=nextNo;
						boqRec.PO_Date=poDate;
					}
					else if(!boqRec.PO.contains(nextNo))
					{
						boqRec.PO=boqRec.PO + ", " + nextNo;
					}
					if(orderedStatus != null)
					{
						boqRec.Status=orderedStatus;
					}
				}
				// 3) Zoho Books — only after the Creator PO is complete
				thisapp.ZohoBooks.Purchase_Order_Creator_books_Sync(poId);
				poRec = Purchase_Order[ID == poId];
				booksId = ifnull(poRec.UAE_ZB_ID,"");
				if(booksId == "")
				{
					booksId = ifnull(poRec.SAR_ZB_ID,"");
				}
				booksMessage = "";
				if(booksId == "")
				{
					// Say why, from the same data the Books function needs
					countryRec = Country[ID == poRec.Country];
					vendorRec = Vendors[ID == poRec.Vendor_Name];
					if(countryRec.count() == 0 || countryRec.Books_Org_ID == null)
					{
						booksMessage = "The PO country has no Books organisation (Country.Books_Org_ID).";
					}
					else if(countryRec.Index_field == 1 && ifnull(vendorRec.UAE_ZB_ID,"") == "")
					{
						booksMessage = "The vendor is not linked to Zoho Books UAE (Vendors.UAE_ZB_ID is empty).";
					}
					else if(countryRec.Index_field == 2 && ifnull(vendorRec.SAR_ZB_ID,"") == "")
					{
						booksMessage = "The vendor is not linked to Zoho Books KSA (Vendors.SAR_ZB_ID is empty).";
					}
					else
					{
						booksMessage = "Zoho Books did not accept the PO — see Developer_Log (\"Error in Create PO In Books\"); check that every item has its Books item ID.";
					}
				}
				response = {"status":"success","id":poId.toString(),"PO_No":nextNo,"Books_Synced":booksId != "","Books_ID":booksId,"Books_Message":booksMessage};
			}
		}
	}
	catch (e)
	{
		response = {"status":"error","code":"EXCEPTION","message":e.toString()};
	}
	return response;
}
