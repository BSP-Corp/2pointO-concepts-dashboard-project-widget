			if(payPoIds.size() > 0)
			{
				for each  payRec in Payment_Made[Purchase_Order in payPoIds] sort by Payment_Date desc
				{
					m = {"ID":payRec.ID.toString(),"Purchase_Order":ifnull(payRec.Purchase_Order,"").toString(),"Amount":ifnull(payRec.Amount,0),"Reference_No":ifnull(payRec.Reference_No,""),"Payment_Note":ifnull(payRec.Payment_Note,""),"Payment_Mode":ifnull(payRec.Payment_Mode,""),"Books_No":ifnull(payRec.Payment_Made_Books_No,"")};
					if(payRec.Payment_Date != null)
					{
						m.put("Payment_Date",payRec.Payment_Date.toString("dd-MMM-yyyy"));
					}
					rows.add(m);
				}
			}
		}
		else if(action == "file")
		{
			fileReport = ifnull(req.get("report"),"").toString();
			fileField = ifnull(req.get("field"),"").toString();
			fileIdText = ifnull(req.get("id"),"").toString();
			filePathText = ifnull(req.get("filepath"),"").toString().trim();
			fileFields = {"All_Delivery_Notes":"Attachments","Purchase_Receive_Report":"Attachments","All_Task_Files":"File_field","All_Projects":"PO_Document"};
			projFileFields = {"PO_Document","Warranty_Document","Sales_Signature","Project_manager_Signature","Health_Safety_Manager_Signature","Solution_Architect_Signature"};
			fileFieldOk = false;
			if(fileReport == "All_Projects")
			{
				fileFieldOk = projFileFields.contains(fileField);
			}
			else if(fileFields.containKey(fileReport))
			{
				fileFieldOk = fileFields.get(fileReport) == fileField;
			}
			filePathOk = filePathText != "";
			if(fileField.endsWith("_Signature"))
			{
				filePathOk = true;
			}
			fileFound = false;
			if(fileFieldOk && fileIdText.isNumber() && filePathOk)
			{
				if(fileFieldOk)
				{
					if(fileReport == "All_Delivery_Notes")
					{
						fileDnCount = Delivery_Note[ID == fileIdText.toLong()].count();
						fileFound = fileDnCount > 0;
					}
					else if(fileReport == "Purchase_Receive_Report")
					{
						filePrCount = Purchase_Receive[ID == fileIdText.toLong()].count();
						fileFound = filePrCount > 0;
					}
					else if(fileReport == "All_Projects")
					{
						fileProjCount = Project[ID == fileIdText.toLong()].count();
						fileFound = fileProjCount > 0;
					}
					else
					{
						fileTaskCount = Task_File[ID == fileIdText.toLong()].count();
						fileFound = fileTaskCount > 0;
					}
				}
			}
			if(!fileFound)
			{
				rows = null;
			}
			else
			{
				fileHeaders = Map();
				fileHeaders.put("environment","development");
				fileUrl = "https://www.zohoapis.com/creator/v2.1/data/2point0concepts/point0concepts/report/" + fileReport + "/" + fileIdText + "/" + fileField + "/download";
				if(filePathText != "")
				{
					fileUrl = fileUrl + "?filepath=" + zoho.encryption.urlEncode(filePathText);
				}
				fileObj = invokeurl
				[
					url :fileUrl
					type :GET
					headers:fileHeaders
					connection:"zoho_creator"
				];
				rows.add({"Name":filePathText,"Content":zoho.encryption.base64Encode(fileObj)});
			}
		}
		else
		{
			rows = null;
		}
		if(rows == null)
		{
			response = {"status":"error","code":"INVALID","message":"Unknown action: " + action};
		}
		else
		{
			response = {"status":"success","records":rows};
		}
	}
	catch (e)
	{
		response = {"status":"error","code":"EXCEPTION","message":e.toString()};
	}
	return response;
}
