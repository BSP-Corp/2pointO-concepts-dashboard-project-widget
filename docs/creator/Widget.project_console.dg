					}
					dnLine = {"ID":dnLineId,"Qty_to_Deliver":ifnull(dnItemRec.Qty_to_Deliver,0),"DN_Amount":ifnull(dnItemRec.DN_Amount,0),"Item_Description":ifnull(dnItemRec.Item_Description,"")};
					dnLocations = List();
