								{
									if(ifnull(placeSerialRec.Serial_Status,"") != "Delivered")
									{
										if(ifnull(placeSerialRec.Serial_No,"") != "")
										{
											placeSerials.add(placeSerialRec.Serial_No);
										}
									}
								}
								stockPlaces.add({"ID":placeRec.ID.toString(),"Label":placeLabel,"Qty":placeLeft,"PR_No":placePrNo,"Warehouse":placeWarehouse,"Location":placeSpot.toString(" · "),"Serials":placeSerials,"Received":placeReceived,"Status":ifnull(placeRec.Stock_Status,""),"Rack":placeRackCode,"Bay":placeBayLetter,"Level":placeLevel,"Side":placeSide,"Pallet":placePallet});
							}
						}
					}
