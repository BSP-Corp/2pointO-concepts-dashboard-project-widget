						{
							dnLine.put("PR_ID",dnPrRec.ID.toString());
							dnShownPrNo = ifnull(dnPrRec.Purchase_Receive_Books_No,"").trim();
							if(dnShownPrNo == "")
							{
								dnShownPrNo = ifnull(dnPrRec.PR_No,"");
							}
							dnLine.put("PR_No",dnShownPrNo);
						}
						if(dnItemRec.Parent_Line_ID != null)
						{
							dnCopyIds = List();
							for each  dnCopyRec in PO_Line_Items[Parent_Line_ID == dnItemRec.Parent_Line_ID && Purchase_Receive == dnItemRec.Parent_PR_ID && is_PR == true]
							{
								dnCopyIds.add(dnCopyRec.ID);
							}
							if(dnCopyIds.size() > 0)
							{
								for each  dnStockRec in Storage[PR_Line in dnCopyIds] sort by ID
								{
									dnPlace = List();
									if(dnStockRec.Warehouse != null)
									{
										dnPlace.add(ifnull(dnStockRec.Warehouse.Warehouse_Name,""));
									}
									dnLabel = ifnull(dnStockRec.Location_Label,"").trim();
									if(dnStockRec.Rack != null)
									{
