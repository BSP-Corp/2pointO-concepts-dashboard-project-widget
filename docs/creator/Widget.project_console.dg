								{
									placeRackCode = ifnull(placeRec.Rack.Rack_Code,"");
									placeSpot.add(placeRackCode);
								}
								if(placeRec.Segment != null)
								{
									placePallet = ifnull(placeRec.Segment.Segment_Code,"");
									placeBayLetter = ifnull(placeRec.Segment.Bay_Letter,"").toString();
									placeLevel = ifnull(placeRec.Segment.Level,"").toString();
									placeSide = ifnull(placeRec.Segment.Side,"").toString();
									placeSpot.add(placePallet);
								}
								if(ifnull(placeRec.Position,"") != "")
								{
									placeSpot.add(placeRec.Position);
								}
								placeSerials = List();
