								{
									placeWarehouse = ifnull(placeRec.Warehouse.Warehouse_Name,"");
								}
								placeSpot = List();
								placeRackCode = "";
								placeBayLetter = "";
								placeLevel = "";
								placeSide = "";
								placePallet = "";
