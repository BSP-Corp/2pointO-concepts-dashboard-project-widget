// Widget.project_console(string quo_data) — READ. Custom API: Widget_Project_Console (POST, quo_data).
// quo_data: {"action":"projects|costing_lines|boq|purchase_orders|po_lines|milestones|budget_review|tasks|plan_milestones|risks|activity", "project_id", "estimate_id", "reference", "po_numbers", "po_ids"}
// Returns {"status":"success","records":[...]} or {"status":"error","code","message"}.
// Child records are matched by the Project lookup OR the project's Accepted_Estimate (sync_boq does not fill Project).
map Widget.project_console(string quo_data)
{
	response = Map();
	try 
	{
		req = Map();
		if(quo_data != null && quo_data.trim() != "")
		{
			req = quo_data.trim().toMap();
		}
		action = ifnull(req.get("action"),"").toString();
		pid = 0;
		if(ifnull(req.get("project_id"),"").toString().isNumber())
		{
			pid = req.get("project_id").toString().toLong();
		}
		eid = 0;
		if(ifnull(req.get("estimate_id"),"").toString().isNumber())
		{
			eid = req.get("estimate_id").toString().toLong();
		}
		rows = List();
		// Projects: all, or one (project_id) with the edit-form extras
		if(action == "projects")
		{
			if(pid > 0)
			{
				projList = Project[ID == pid];
			}
			else
			{
				projList = Project[ID != 0] sort by Project_Reference;
			}
			for each  projRec in projList
			{
				m = {"ID":projRec.ID.toString(),"Project_Reference":ifnull(projRec.Project_Reference,""),"Project_Name":ifnull(projRec.Project_Name,""),"Type_of_Project":ifnull(projRec.Type_of_Project,""),"City":ifnull(projRec.City,""),"State":ifnull(projRec.State,""),"Project_Description":ifnull(projRec.Project_Description,""),"Client_PO_No":ifnull(projRec.Client_PO_No,""),"Sales_Order_No":ifnull(projRec.Sales_Order_No,""),"Project_Value_PO":ifnull(projRec.Project_Value_PO,0),"Estimate_Value_Sub_Total":ifnull(projRec.Estimate_Value_Sub_Total,0),"Hardware":ifnull(projRec.Hardware,0),"Software":ifnull(projRec.Software,0),"Outsourced_Services":ifnull(projRec.Outsourced_Services,0),"Logistics":ifnull(projRec.Logistics,0),"point0_Services":ifnull(projRec.point0_Services,0),"Estimated_Margin":ifnull(projRec.Estimated_Margin,0),"Total_Budget_Cost":ifnull(projRec.Total_Budget_Cost,0),"Project_No":ifnull(projRec.Project_No,""),"Status_History":ifnull(projRec.Status_History,"")};
				if(projRec.Start_Date != null)
				{
					m.put("Start_Date",projRec.Start_Date.toString("dd-MMM-yyyy"));
				}
				if(projRec.Project_Completion_Date != null)
				{
					m.put("Project_Completion_Date",projRec.Project_Completion_Date.toString("dd-MMM-yyyy"));
				}
				if(projRec.Actual_Completion_Date != null)
				{
					m.put("Actual_Completion_Date",projRec.Actual_Completion_Date.toString("dd-MMM-yyyy"));
				}
				if(projRec.Date_PO_Received != null)
				{
					m.put("Date_PO_Received",projRec.Date_PO_Received.toString("dd-MMM-yyyy"));
				}
				if(projRec.Client_Name != null)
				{
					m.put("Client_Name",{"ID":projRec.Client_Name.toString(),"zc_display_value":projRec.Client_Name.Customer_Name});
				}
				if(projRec.Project_Status != null)
				{
					m.put("Project_Status",{"ID":projRec.Project_Status.toString(),"zc_display_value":projRec.Project_Status.Status_Name});
				}
				if(projRec.Currency != null)
				{
					m.put("Currency",{"ID":projRec.Currency.toString(),"zc_display_value":projRec.Currency.Currency_Name});
				}
				if(projRec.Accepted_Estimate != null)
				{
					m.put("Accepted_Estimate",{"ID":projRec.Accepted_Estimate.toString(),"zc_display_value":projRec.Accepted_Estimate.Quote_No});
				}
				if(projRec.Project_Registration_Task_List != null)
				{
					m.put("Project_Registration_Task_List",{"ID":projRec.Project_Registration_Task_List.toString(),"zc_display_value":projRec.Project_Registration_Task_List.Task_Name});
				}
				if(projRec.Project_Manager != null)
				{
					m.put("Project_Manager",{"ID":projRec.Project_Manager.toString(),"zc_display_value":projRec.Project_Manager.Name});
				}
				if(projRec.Solution_Architect != null)
				{
					m.put("Solution_Architect",{"ID":projRec.Solution_Architect.toString(),"zc_display_value":projRec.Solution_Architect.Name});
				}
				if(projRec.Finance_Representative != null)
				{
					m.put("Finance_Representative",{"ID":projRec.Finance_Representative.toString(),"zc_display_value":projRec.Finance_Representative.Name});
				}
				if(projRec.Health_Safety_Manager != null)
				{
					m.put("Health_Safety_Manager",{"ID":projRec.Health_Safety_Manager.toString(),"zc_display_value":projRec.Health_Safety_Manager.Name});
				}
				if(projRec.Sales_Representative != null)
				{
					m.put("Sales_Representative",{"ID":projRec.Sales_Representative.toString(),"zc_display_value":projRec.Sales_Representative.Name});
				}
				if(projRec.Lead_Engineer != null)
				{
					m.put("Lead_Engineer",{"ID":projRec.Lead_Engineer.toString(),"zc_display_value":projRec.Lead_Engineer.Name});
				}
				if(projRec.Logistics_Coordinator != null)
				{
					m.put("Logistics_Coordinator",{"ID":projRec.Logistics_Coordinator.toString(),"zc_display_value":projRec.Logistics_Coordinator.Name});
				}
				if(projRec.Sales_Person != null)
				{
					m.put("Sales_Person",{"ID":projRec.Sales_Person.toString(),"zc_display_value":projRec.Sales_Person.Name});
				}
				if(projRec.Project_manager_Approval != null)
				{
					m.put("Project_manager_Approval",{"ID":projRec.Project_manager_Approval.toString(),"zc_display_value":projRec.Project_manager_Approval.Name});
				}
				countryList = List();
				for each  countryId in ifnull(projRec.Country,List())
				{
					countryRec = Country[ID == countryId];
					countryList.add({"ID":countryId.toString(),"zc_display_value":ifnull(countryRec.Country_Name,"")});
				}
				m.put("Country",countryList);
				if(projRec.Address != null)
				{
					m.put("Address",{"address_line_1":ifnull(projRec.Address.address_line_1,""),"address_line_2":ifnull(projRec.Address.address_line_2,""),"zc_display_value":ifnull(projRec.Address.address_line_1,"")});
				}
				if(pid > 0)
				{
					m.put("PO_Document",ifnull(projRec.PO_Document,""));
					m.put("Health_Safety_Manager_Signature",ifnull(projRec.Health_Safety_Manager_Signature,""));
					m.put("Sales_Signature",ifnull(projRec.Sales_Signature,""));
					m.put("Project_manager_Signature",ifnull(projRec.Project_manager_Signature,""));
				}
				rows.add(m);
			}
		}
		// Cost lines = asset & network register (Assets, Deployment tabs)
		else if(action == "costing_lines")
		{
			for each  lineRec in Costing_Lineitem[Project == pid || Cost_Analysis == eid] sort by Added_Time
			{
				m = {"ID":lineRec.ID.toString(),"Work_Package":ifnull(lineRec.Work_Package,""),"Model":ifnull(lineRec.Model,""),"Item_Description":ifnull(lineRec.Item_Description,""),"Quantity":ifnull(lineRec.Quantity,0),"Total_Cost":ifnull(lineRec.Total_Cost,0),"Total_Price":ifnull(lineRec.Total_Price,0),"Total_Profit":ifnull(lineRec.Total_Profit,0),"Notes":ifnull(lineRec.Notes,""),"Serial_Number":ifnull(lineRec.Serial_Number,""),"MAC_Address_Control":ifnull(lineRec.MAC_Address_Control,""),"MAC_Address_Dante":ifnull(lineRec.MAC_Address_Dante,""),"Provision":ifnull(lineRec.Provision,""),"Outlet_GOP_No":ifnull(lineRec.Outlet_GOP_No,""),"Networked":ifnull(lineRec.Networked,false),"Switch_Ref":ifnull(lineRec.Switch_Ref,""),"Port_No":ifnull(lineRec.Port_No,""),"POE":ifnull(lineRec.POE,""),"VLAN":ifnull(lineRec.VLAN,""),"IP_Address":ifnull(lineRec.IP_Address,""),"Subnet_Mask":ifnull(lineRec.Subnet_Mask,""),"Host_Name":ifnull(lineRec.Host_Name,""),"Gateway":ifnull(lineRec.Gateway,""),"DNS_Server_1":ifnull(lineRec.DNS_Server_1,""),"DNS_Server_2":ifnull(lineRec.DNS_Server_2,"")};
				if(lineRec.Warranty_Start_Date != null)
				{
					m.put("Warranty_Start_Date",lineRec.Warranty_Start_Date.toString("dd-MMM-yyyy"));
				}
				if(lineRec.Warranty_End_Date != null)
				{
					m.put("Warranty_End_Date",lineRec.Warranty_End_Date.toString("dd-MMM-yyyy"));
				}
				if(lineRec.Vendor != null)
				{
					m.put("Vendor",lineRec.Vendor.Vendor_Name);
				}
				if(lineRec.Category != null)
				{
					m.put("Category",lineRec.Category.Category_Name);
				}
				if(lineRec.Type_field != null)
				{
					m.put("Type_field",lineRec.Type_field.Type_Name);
				}
				if(lineRec.Brand != null)
				{
					m.put("Brand",lineRec.Brand.Brand_Name);
				}
				if(lineRec.SKU != null)
				{
					m.put("SKU",lineRec.SKU.SKU);
				}
				if(lineRec.Unit_of_Measurement != null)
				{
					m.put("Unit_of_Measurement",lineRec.Unit_of_Measurement.Unit_Name);
				}
				if(lineRec.Delivery_Status != null)
				{
					m.put("Delivery_Status",lineRec.Delivery_Status.Status_Name);
				}
				if(lineRec.Installation_Status != null)
				{
					m.put("Installation_Status",lineRec.Installation_Status.Status_Name);
				}
				rows.add(m);
			}
		}
		// BOQ (BOQ, Procurement tabs)
		else if(action == "boq")
		{
			reference = ifnull(req.get("reference"),"").toString().trim();
			if(reference == "")
			{
				reference = "-";
			}
			for each  boqRec in BOQ[Project == pid || Estimate1 == eid || Project_Reference == reference] sort by Added_Time
			{
				m = {"ID":boqRec.ID.toString(),"Work_Package":ifnull(boqRec.Work_Package,""),"Model":ifnull(boqRec.Model,""),"Description":ifnull(boqRec.Description,""),"Quantity":ifnull(boqRec.Quantity,0),"Warranty":ifnull(boqRec.Warranty,""),"PO":ifnull(boqRec.PO,""),"Mode_of_Transit":ifnull(boqRec.Mode_of_Transit,""),"Delivered_to_2_0_Warehouse":ifnull(boqRec.Delivered_to_2_0_Warehouse,""),"Delivered_to_Customer":ifnull(boqRec.Delivered_to_Customer,"")};
				if(boqRec.PO_Date != null)
				{
					m.put("PO_Date",boqRec.PO_Date.toString("dd-MMM-yyyy"));
				}
				if(boqRec.ETA != null)
				{
					m.put("ETA",boqRec.ETA.toString("dd-MMM-yyyy"));
				}
				if(boqRec.Date_delivered_to_warehouse != null)
				{
					m.put("Date_delivered_to_warehouse",boqRec.Date_delivered_to_warehouse.toString("dd-MMM-yyyy"));
				}
				if(boqRec.Date_delivered_to_customer != null)
				{
					m.put("Date_delivered_to_customer",boqRec.Date_delivered_to_customer.toString("dd-MMM-yyyy"));
				}
				if(boqRec.Vendors != null)
				{
					m.put("Vendors",{"ID":boqRec.Vendors.toString(),"zc_display_value":boqRec.Vendors.Vendor_Name});
				}
				if(boqRec.Category != null)
				{
					m.put("Category",boqRec.Category.Category_Name);
				}
				if(boqRec.Type_form != null)
				{
					m.put("Type_form",boqRec.Type_form.Type_Name);
				}
				if(boqRec.Brand != null)
				{
					m.put("Brand",boqRec.Brand.Brand_Name);
				}
				if(boqRec.SKU != null)
				{
					m.put("SKU",{"ID":boqRec.SKU.toString(),"zc_display_value":boqRec.SKU.SKU});
				}
				lineIds = List();
				for each  lineId in ifnull(boqRec.Accepted_Costing_Lineitem,List())
				{
					lineIds.add(lineId.toString());
				}
				if(lineIds.size() == 0)
				{
					for each  lineId in ifnull(boqRec.Costing_Lineitem,List())
					{
						lineIds.add(lineId.toString());
					}
				}
				m.put("Costing_Lineitem",lineIds);
				if(boqRec.UOM != null)
				{
					m.put("UOM",boqRec.UOM.Unit_Name);
				}
				if(boqRec.Status != null)
				{
					m.put("Status",{"ID":boqRec.Status.toString(),"zc_display_value":boqRec.Status.Status_Name});
				}
				rows.add(m);
			}
		}
		// Purchase orders named on the project's BOQ lines (BOQ.PO = Purchase_Order.PO_No)
		else if(action == "purchase_orders")
		{
			poNumbers = ifnull(req.get("po_numbers"),List());
			if(poNumbers.size() > 0)
			{
				for each  poRec in Purchase_Order[PO_No in poNumbers]
				{
					booksPoId = ifnull(poRec.UAE_ZB_ID,"");
					if(booksPoId == "")
					{
						booksPoId = ifnull(poRec.SAR_ZB_ID,"");
					}
					m = {"ID":poRec.ID.toString(),"PO_No":ifnull(poRec.PO_No,""),"Reference":ifnull(poRec.Reference,""),"Sub_Total":ifnull(poRec.Sub_Total,0),"Discount":ifnull(poRec.Discount,0),"Total_Cost":ifnull(poRec.Total_Cost,0),"Issued_By":ifnull(poRec.Added_User,""),"Books_ID":booksPoId};
					if(poRec.PO_Status != null)
					{
						m.put("PO_Status",poRec.PO_Status.Status_Name);
					}
					if(poRec.Date_field != null)
					{
						m.put("Date_field",poRec.Date_field.toString("dd-MMM-yyyy"));
					}
					if(poRec.Delivery_Date != null)
					{
						m.put("Delivery_Date",poRec.Delivery_Date.toString("dd-MMM-yyyy"));
					}
					if(poRec.Vendor_Name != null)
					{
						m.put("Vendor_Name",poRec.Vendor_Name.Vendor_Name);
					}
					boqIds = List();
					for each  boqId in ifnull(poRec.BOQ,List())
					{
						boqIds.add(boqId.toString());
					}
					m.put("BOQ",boqIds);
					m.put("Books_Synced",ifnull(poRec.UAE_ZB_ID,"") != "" || ifnull(poRec.SAR_ZB_ID,"") != "");
					rows.add(m);
				}
			}
		}
		else if(action == "po_lines")
		{
			poIds = List();
			for each  poId in ifnull(req.get("po_ids"),List())
			{
				poIds.add(poId.toString().toLong());
			}
			if(poIds.size() > 0)
			{
				for each  poLineRec in PO_Line_Items[Purchase_Order in poIds]
				{
					m = {"ID":poLineRec.ID.toString(),"Item_Description":ifnull(poLineRec.Item_Description,""),"Quantity":ifnull(poLineRec.Quantity,0),"Rate":ifnull(poLineRec.Rate,0),"Amount":ifnull(poLineRec.Amount,0),"Quantity_Received":ifnull(poLineRec.Quantity_Received,0),"Quantity_to_be_Received":ifnull(poLineRec.Quantity_to_be_Received,0),"Received":ifnull(poLineRec.Received,false)};
					if(poLineRec.Purchase_Order != null)
					{
						m.put("Purchase_Order",{"ID":poLineRec.Purchase_Order.toString(),"zc_display_value":poLineRec.Purchase_Order.PO_No});
					}
					if(poLineRec.Item_Name != null)
					{
						m.put("Item_Name",{"ID":poLineRec.Item_Name.toString(),"zc_display_value":poLineRec.Item_Name.Item_Name});
					}
					rows.add(m);
				}
			}
		}
		else if(action == "milestones")
		{
			for each  msRec in Payment_Milestone[Project == pid || Estimate == eid] sort by Added_Time
			{
				rows.add({"ID":msRec.ID.toString(),"MILESTONES":ifnull(msRec.MILESTONES,""),"AMOUNT":ifnull(msRec.AMOUNT,0),"Percentage":ifnull(msRec.Percentage,0),"Terms":ifnull(msRec.Terms,"")});
			}
		}
		else if(action == "budget_review")
		{
			for each  sumRec in Estimate_Summary[Project == pid || Estimate == eid] sort by Added_Time
			{
				m = {"ID":sumRec.ID.toString(),"Cost":ifnull(sumRec.Cost,0),"Total_Cost":ifnull(sumRec.Total_Cost,0),"Total_price":ifnull(sumRec.Total_price,0),"PROFIT":ifnull(sumRec.PROFIT,0),"MARGIN":ifnull(sumRec.MARGIN,0)};
				if(sumRec.Description != null)
				{
					m.put("Description",sumRec.Description.Category_Name);
				}
				rows.add(m);
			}
		}
		// Tasks and milestones (Task.Type_field) of the project
		else if(action == "tasks")
		{
			for each  taskRec in Task[Project_Name == pid] sort by Task_Start_Date
			{
				m = {"ID":taskRec.ID.toString(),"Task_Name":ifnull(taskRec.Task_Name,""),"Type_field":ifnull(taskRec.Type_field,""),"Task_Description":ifnull(taskRec.Task_Description,""),"Priority":ifnull(taskRec.Priority,""),"Precent_Complete":ifnull(taskRec.Precent_Complete,0),"Work_Hours":ifnull(taskRec.Work_Hours,0),"Work_Package":ifnull(taskRec.Work_Package,""),"Billing_Type":ifnull(taskRec.Billing_Type,""),"Delivered":ifnull(taskRec.Delivered,false),"Duration":ifnull(taskRec.Duration,""),"Task_No":ifnull(taskRec.Task_No,""),"Added_User":ifnull(taskRec.Added_User,"")};
				if(taskRec.Task_Start_Date != null)
				{
					m.put("Task_Start_Date",taskRec.Task_Start_Date.toString("dd-MMM-yyyy"));
				}
				if(taskRec.Task_End_Date != null)
				{
					m.put("Task_End_Date",taskRec.Task_End_Date.toString("dd-MMM-yyyy"));
				}
				if(taskRec.Actual_Start_Date != null)
				{
					m.put("Actual_Start_Date",taskRec.Actual_Start_Date.toString("dd-MMM-yyyy"));
				}
				if(taskRec.Actual_Complete_Date != null)
				{
					m.put("Actual_Complete_Date",taskRec.Actual_Complete_Date.toString("dd-MMM-yyyy"));
				}
				if(taskRec.Task_Status != null)
				{
					m.put("Task_Status",{"ID":taskRec.Task_Status.toString(),"zc_display_value":taskRec.Task_Status.Status_Name});
				}
				if(taskRec.Parent_Task != null)
				{
					m.put("Parent_Task",{"ID":taskRec.Parent_Task.toString(),"zc_display_value":taskRec.Parent_Task.Task_Name});
				}
				owners = List();
				for each  ownerId in ifnull(taskRec.Owners,List())
				{
					ownerRec = Users[ID == ownerId];
					owners.add({"ID":ownerId.toString(),"zc_display_value":ifnull(ownerRec.Name,"")});
				}
				m.put("Owners",owners);
				lineIds = List();
				for each  lineId in ifnull(taskRec.Work_Packages,List())
				{
					lineIds.add(lineId.toString());
				}
				m.put("Work_Packages",lineIds);
				rows.add(m);
			}
		}
		// Milestone form (Project lookup): planned milestones of the project
		else if(action == "plan_milestones")
		{
			for each  planRec in Milestone[Project == pid] sort by Milestone_No
			{
				m = {"ID":planRec.ID.toString(),"Milestone_No":ifnull(planRec.Milestone_No,""),"Milestone_Name":ifnull(planRec.Milestone_Name,""),"Flag":ifnull(planRec.Flag,""),"Starts_After_In":ifnull(planRec.Starts_After_In,""),"Starts_after":ifnull(planRec.Starts_after,0),"Duration":ifnull(planRec.Duration,0)};
				if(planRec.Status != null)
				{
					m.put("Status",{"ID":planRec.Status.toString(),"zc_display_value":planRec.Status.Status_Name});
				}
				if(planRec.Owner != null)
				{
					m.put("Owner",{"ID":planRec.Owner.toString(),"zc_display_value":planRec.Owner.Name});
				}
				if(planRec.Task_List != null)
				{
					m.put("Task_List",{"ID":planRec.Task_List.toString(),"zc_display_value":planRec.Task_List.Task_Name});
				}
				rows.add(m);
			}
		}
		// Project_Risk form (Risk Register)
		else if(action == "risks")
		{
			for each  riskRec in Project_Risk[Project_Name == pid] sort by Risk_ID
			{
				m = {"ID":riskRec.ID.toString(),"Risk_ID":ifnull(riskRec.Risk_ID,""),"Risk_Description":ifnull(riskRec.Risk_Description,""),"Cause":ifnull(riskRec.Cause,""),"Probability":ifnull(riskRec.Probability,""),"Impact":ifnull(riskRec.Impact,""),"Risk_Severity":ifnull(riskRec.Risk_Severity,""),"Risk_Score":ifnull(riskRec.Risk_Score,0),"Priority":ifnull(riskRec.Priority,"")};
				m.put("Project_Name",{"ID":riskRec.Project_Name.toString(),"zc_display_value":riskRec.Project_Name.Project_Reference});
				if(riskRec.Risk_Status != null)
				{
					m.put("Risk_Status",{"ID":riskRec.Risk_Status.toString(),"zc_display_value":riskRec.Risk_Status.Status_Name});
				}
				if(riskRec.Risk_Owner != null)
				{
					m.put("Risk_Owner",{"ID":riskRec.Risk_Owner.toString(),"zc_display_value":riskRec.Risk_Owner.Name});
				}
				if(riskRec.Department != null)
				{
					m.put("Department",{"ID":riskRec.Department.toString(),"zc_display_value":riskRec.Department.Name});
				}
				rows.add(m);
			}
		}
		// Activity_Stream (who changed what and when), newest first; record_id narrows it to one record
		else if(action == "activity")
		{
			recordId = ifnull(req.get("record_id"),"").toString();
			if(recordId != "")
			{
				activityList = Activity_Stream[Project == pid && Record_ID == recordId] sort by Added_Time desc range from 1 to 300;
			}
			else
			{
				activityList = Activity_Stream[Project == pid] sort by Added_Time desc range from 1 to 300;
			}
			for each  activityRec in activityList
			{
				m = {"ID":activityRec.ID.toString(),"Module":ifnull(activityRec.Module,""),"Record_ID":ifnull(activityRec.Record_ID,""),"Record_Name":ifnull(activityRec.Record_Name,""),"Action":ifnull(activityRec.Action_field,""),"Field_Name":ifnull(activityRec.Field_Name,""),"Old_Value":ifnull(activityRec.Old_Value,""),"New_Value":ifnull(activityRec.New_Value,""),"Changed_By":ifnull(activityRec.Changed_By,"")};
				// Changed_On is a Date field; the exact time is the record's Added_Time
				m.put("Changed_On",activityRec.Added_Time.toString("dd-MMM-yyyy HH:mm:ss"));
				rows.add(m);
			}
		}
		else
		{
			rows = null;
		}
		if(rows == null)
		{
			response = {"status":"error","code":"INVALID","message":"Unknown action: " + action};
		}
		else
		{
			response = {"status":"success","records":rows};
		}
	}
	catch (e)
	{
		response = {"status":"error","code":"EXCEPTION","message":e.toString()};
	}
	return response;
}
