map Widget.can_edit(string project_id)
{
	result = {"can_edit":false,"is_admin":false,"reason":"","user_name":zoho.loginuser};
	projRec = Project[ID == 0];
	if(project_id.isNumber())
	{
		projRec = Project[ID == project_id.toLong()];
	}
	isAdmin = zoho.loginuser == zoho.adminuser;
	if(zoho.loginuserid.equalsIgnoreCase(zoho.adminuserid))
	{
		isAdmin = true;
	}
	loginEmail = zoho.loginuserid.trim().toLowerCase();
	loginRec = Users[Email == zoho.loginuserid];
	if(loginRec.count() == 0)
	{
		for each  userRec in Users[Email != ""]
		{
			if(ifnull(userRec.Email,"").trim().toLowerCase() == loginEmail)
			{
				loginRec = Users[ID == userRec.ID];
			}
		}
	}
	loginRole = "";
	if(loginRec.count() > 0)
	{
		loginRole = ifnull(loginRec.Role,"");
		if(ifnull(loginRec.Name,"") != "")
		{
			result.put("user_name",loginRec.Name);
		}
	}
	if(loginRole == "Administrator")
	{
		isAdmin = true;
	}
	result.put("can_edit",true);
	result.put("is_admin",isAdmin);
	return result;
}
