map Widget.status_order()
{
	order = Map();
	projectStages = List();
	for each  projStatusRec in Status[Modules.contains("Project") && Order > 0] sort by Order
	{
		projModules = projStatusRec.Modules;
		if(projModules.contains("Project"))
		{
			projStatusName = ifnull(projStatusRec.Status_Name,"").trim();
			if(projStatusName != "" && !projectStages.contains(projStatusName))
			{
				projectStages.add(projStatusName);
			}
		}
	}
	anytime = List();
	for each  anyStatusRec in Status[Modules.contains("Project")] sort by Index_field
	{
		anyModules = anyStatusRec.Modules;
		anyStatusName = ifnull(anyStatusRec.Status_Name,"").trim();
		anyOrder = ifnull(anyStatusRec.Order,0);
		if(!anyModules.contains("Project"))
		{
			anyOrder = 1;
		}
		if(anyOrder <= 0)
		{
			if(anyStatusName != "" && !anytime.contains(anyStatusName))
			{
				anytime.add(anyStatusName);
			}
		}
	}
	taskOrder = List();
	for each  taskStatusRec in Status[Modules.contains("Task") && Order > 0] sort by Order
	{
		taskStatusName = ifnull(taskStatusRec.Status_Name,"").trim();
		if(taskStatusName != "" && !taskOrder.contains(taskStatusName))
		{
			taskOrder.add(taskStatusName);
		}
	}
	for each  taskRestRec in Status[Modules.contains("Task")] sort by Index_field
	{
		taskRestName = ifnull(taskRestRec.Status_Name,"").trim();
		if(taskRestName != "" && !taskOrder.contains(taskRestName))
		{
			taskOrder.add(taskRestName);
		}
	}
	boqOrder = List();
	for each  boqStatusRec in Status[Modules.contains("BOQ") && Order > 0] sort by Order
	{
		boqStatusName = ifnull(boqStatusRec.Status_Name,"");
		if(boqStatusName.trim() != "" && !boqOrder.contains(boqStatusName))
		{
			boqOrder.add(boqStatusName);
		}
	}
	for each  boqRestRec in Status[Modules.contains("BOQ")] sort by Index_field
	{
		boqRestName = ifnull(boqRestRec.Status_Name,"");
		if(boqRestName.trim() != "" && !boqOrder.contains(boqRestName))
		{
			boqOrder.add(boqRestName);
		}
	}
	order.put("project",projectStages);
	order.put("anytime",anytime);
	order.put("task",taskOrder);
	order.put("boq",boqOrder);
	return order;
}
